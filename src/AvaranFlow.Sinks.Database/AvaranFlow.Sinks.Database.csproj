<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net461;netstandard2.0</TargetFrameworks>
    <RootNamespace>AvaranFlow.Sinks.Database</RootNamespace>
    <AssemblyName>AvaranFlow.Sinks.Database</AssemblyName>
    <PackageId>AvaranFlow.Sinks.Database</PackageId>
    <Title>AvaranFlow.Sinks.Database</Title>
    <Description>Parameterized SQL Server database sink for AvaranFlow with batched upsert and retry recovery.</Description>
    <PackageTags>avaranflow;exception;logging;sql;database;sink;resilience</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaranFlow.Core\AvaranFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <Reference Include="System.Data" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>
</Project>
